# Gateway (single endpoint for both Whisper + LLM)
API_KEY=your_gateway_key
BASE_URL=https://your-gateway.com/v1
LLM_MODEL=your-llm-model-id
Whisper_MODEL=your-whisper-model-id

# Optional
LOCAL_OUTPUT_DIR=resources          # media root: downloads/, clips/, uploads/
SHORTS_DOWNLOADS_DIR=resources/downloads  # source videos + transcript caches
YT_COOKIES_FILE=cookies.txt      # YouTube cookies, for restricted videos

# --- API server (auto-generated on first start if unset) ---
SHORTS_API_KEY=
SHORTS_MAX_WORKERS=4             # how many videos process in parallel
SHORTS_HOST=0.0.0.0
SHORTS_PORT=8100
SHORTS_DB_PATH=shorts_generator.db  # SQLite records (videos/clips/logs) at project root
SHORTS_PUBLIC_BASE=http://localhost:8100   # URL n8n uses to reach this server
SHORTS_VIDEOS_DIR=resources/clips  # rendered clips (never deleted)
SHORTS_UPLOADS_DIR=resources/uploads # uploaded source videos
SHORTS_MAX_UPLOAD_MB=2000        # max uploaded video size in MB (0 = disabled)
